#!/usr/bin/env bash
# Block commits that add a home-directory path. Install once with:
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
if git diff --cached -U0 | grep -E '^\+' | grep -qE "/(Users|home)/[^/~ ]+"; then
  echo "Commit blocked: staged changes contain a home-directory path."
  echo "Run scripts/scrub_paths.sh, then git add the files again."
  exit 1
fi
